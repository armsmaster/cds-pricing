# Copy to `.env` and adjust for your environment. `docker compose` reads `.env`
# automatically. All values are optional; the defaults target public registries
# and direct internet access.

# --- build: base image + Python index (e.g. behind a Nexus mirror) ---
# BASE_IMAGE=nexus.example.com:8082/python:3.12-slim-bookworm
# PIP_INDEX_URL=https://nexus.example.com/repository/pypi-proxy/simple

# --- runtime: outbound HTTP proxy for MOEX ISS (leave unset if reachable directly) ---
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,::1,.example.com

# --- runtime: database location inside the container (default /code/data/app.db) ---
# PCDS_DB_PATH=/code/data/app.db

# --- runtime: MOEX TLS (default: system CA bundle; set to false to disable) ---
# PCDS_MOEX_VERIFY=true
